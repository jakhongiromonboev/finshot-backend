{
  "name": "finshot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finshot backend assignment",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && NODE_ENV=development node --env-file=.env dist/main.js",
    "start:prod": "NODE_ENV=production node --env-file=.env.production dist/main.js",
    "start:dev": "NODE_ENV=development nest start --watch --env-file .env",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
